<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dissonance.app">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dissonance">
        <activity
            android:name=".screens.CreateReviewScreen"
            android:exported="true"
            android:label="Create Review"
            android:theme="@style/Theme.Dissonance" />
        <!-- LoginActivity as the Landing Page -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:label="Login"
            android:theme="@style/Theme.Dissonance">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- ProfileScreen -->
        <activity
            android:name=".screens.ProfileScreen"
            android:exported="true"
            android:label="Profile"
            android:theme="@style/Theme.Dissonance"></activity> <!-- ProfileEditScreen -->
        <activity
            android:name=".screens.ProfileEditScreen"
            android:exported="true"
            android:label="Edit Profile"
            android:theme="@style/Theme.Dissonance"></activity>
    </application>

</manifest>