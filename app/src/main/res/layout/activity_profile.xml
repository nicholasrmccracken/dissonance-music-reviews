<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="wrap_content"
            android:layout_height="190dp"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/banner_crescent" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Profile Info Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="183dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="149dp"
                android:layout_height="158dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imageView5"
                    android:layout_width="match_parent"
                    android:layout_height="127dp"
                    android:scaleType="centerInside"
                    android:visibility="visible"
                    app:srcCompat="@drawable/logo" />

                <TextView
                    android:id="@+id/username"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:fontFamily="monospace"
                    android:gravity="center|top"
                    android:text="Username"
                    android:textColor="#779FE6" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/numberOfRatings"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:gravity="bottom|center"
                        android:text="12"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/numberOfReviews"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:gravity="bottom|center"
                        android:text="15"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/numberOfFollowers"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:gravity="bottom|center"
                        android:text="531"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textView5"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:gravity="center|top"
                        android:text="Ratings"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/textView6"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:gravity="center|top"
                        android:text="Reviews"
                        android:textColor="#FAFAFA" />

                    <TextView
                        android:id="@+id/textView7"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center|top"
                        android:text="Followers"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- About Me Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="186dp"
            android:background="#0029349B"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView11"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:fontFamily="monospace"
                android:gravity="center|left"
                android:text="About Me"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <View
                android:id="@+id/view"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@color/secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="129dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="129dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/aboutMe"
                        android:layout_width="wrap_content"
                        android:layout_height="129dp"
                        android:layout_weight="1"
                        android:text="Seem's Quite Empty..."
                        android:textColor="#779FE6" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Recent Activity Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="282dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView16"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:fontFamily="monospace"
                android:gravity="center|left"
                android:text="Recent Activity"
                android:textColor="#F6F6F6"
                android:textSize="18sp" />

            <View
                android:id="@+id/view8"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@color/secondary" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/fragmentContainerView2"
                android:name="com.dissonance.app.fragments.ReviewFragment"
                android:layout_width="match_parent"
                android:layout_height="222dp" />
        </LinearLayout>

        <!-- Buttons Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <Button
                    android:id="@+id/editAboutMe"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/btn_spotify"
                    android:text="Edit About Me"
                    android:textColor="#68D96C" />

                <Button
                    android:id="@+id/editProfileBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/btn_profile"
                    android:text="Settings"
                    android:textColor="#68D96C" />
            </LinearLayout>

            <Button
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/btn_profile"
                android:text="Log Out"
                android:textAllCaps="false"
                android:textColor="#68D96C" />
        </LinearLayout>

        <!-- Location -->
        <TextView
            android:id="@+id/locationText"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:text="Location Not Set"
            android:textAlignment="center"
            android:textColor="#779FE6" />
    </LinearLayout>

    <!-- Bottom Navigation -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navbar_fragment_container"
        android:name="com.dissonance.app.fragments.NavbarFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
