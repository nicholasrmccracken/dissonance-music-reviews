<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Dissonance" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryContainer">@color/tertiary</item>
        <item name="colorSecondary">@color/secondary</item>

        <!-- Background and Surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/background</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/secondary</item>

        <!-- Status Bar and Navigation -->
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/primary</item>

        <!-- Button & Ripple -->
        <item name="colorButtonNormal">@color/secondary</item>
        <item name="android:colorControlHighlight">@color/ui_selection</item>
        <item name="android:colorAccent">@color/tertiary</item>
    </style>
</resources>